{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000"
  },
  "autoMemoryDirectory": "~/.claude/memory/deduxit",
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo hack check *)",
      "Bash(cargo deny check *)",
      "Bash(cargo update --dry-run *)",
      "Bash(cargo run -p deduxit-cli *)",
      "Bash(nix build *)",
      "Bash(nix eval *)",
      "Bash(nix fmt *)",
      "Bash(nix flake check *)",
      "Bash(nix flake show *)",
      "Bash(nix flake metadata *)",
      "Bash(jj status *)",
      "Bash(jj st *)",
      "Bash(jj log *)",
      "Bash(jj diff *)",
      "Bash(jj show *)",
      "Bash(jj evolog *)",
      "Bash(jj op log *)",
      "Bash(jj op show *)",
      "Bash(jj file list *)",
      "Bash(jj file show *)",
      "Bash(jj file annotate *)",
      "Bash(jj bookmark list *)",
      "Bash(jj git remote list *)",
      "Bash(jj config get *)",
      "Bash(jj config list *)",
      "Bash(jj root *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cut *)",
      "Bash(wc *)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.jj-vcs.dev)"
    ],
    "ask": [
      "Bash(jj git push)",
      "Bash(jj git push *main*)",
      "Bash(jj git push *--all*)",
      "Bash(jj git push *--tracked*)",
      "Bash(jj git push *--deleted*)",
      "Bash(jj git push *-r *)",
      "Bash(jj git push *--revisions*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(gh api graphql *)",
      "Bash(gh auth *)",
      "Bash(gh alias *)",
      "Bash(gh cache delete *)",
      "Bash(gh codespace *)",
      "Bash(gh config set *)",
      "Bash(gh extension *)",
      "Bash(gh gist create *)",
      "Bash(gh gist delete *)",
      "Bash(gh gist edit *)",
      "Bash(gh gpg-key *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh label delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo autolink *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo sync *)",
      "Bash(gh repo unarchive *)",
      "Bash(gh run delete *)",
      "Bash(gh secret *)",
      "Bash(gh ssh-key *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow run *)"
    ],
    "deny": [
      "Bash(git *)",
      "Bash(cargo publish *)",
      "Bash(cargo yank *)",
      "Bash(cargo owner *)",
      "Bash(cargo login *)",
      "Edit(/LICENSE)",
      "Edit(/Cargo.lock)",
      "Edit(/flake.lock)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh",
            "args": [],
            "statusMessage": "Formatting with treefmt",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify-supervisor.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-jj-worktree",
            "args": [],
            "statusMessage": "Creating jj workspace",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-jj-worktree",
            "args": [],
            "statusMessage": "Removing jj workspace",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
